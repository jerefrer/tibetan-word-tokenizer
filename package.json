{
  "name": "tibetan-word-tokenizer",
  "version": "1.0.1",
  "description": "A JavaScript port of OpenPecha's Botok: Tibetan word tokenizer with Sanskrit detection",
  "keywords": [
    "tibetan",
    "tokenizer",
    "botok",
    "nlp",
    "word-segmentation",
    "sanskrit"
  ],
  "author": "Jérémy Frère (https://frerejeremy.me)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jerefrer/tibetan-word-tokenizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerefrer/tibetan-word-tokenizer.git"
  },
  "bugs": {
    "url": "https://github.com/jerefrer/tibetan-word-tokenizer/issues"
  },
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./trie": "./src/trie.js",
    "./tokenizer": "./src/tokenizer.js",
    "./chunks": "./src/chunks.js",
    "./data/dictionary.json": "./data/dictionary.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build-data": "node scripts/build-dictionary.js"
  },
  "files": [
    "src/",
    "data/dictionary.json",
    "NOTICE"
